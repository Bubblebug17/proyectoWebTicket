RewriteEngine On
# Prefijo de carpeta: se resuelve solo según la ubicación de este .htaccess (no hace falta RewriteBase fijo).

# Si el archivo o directorio existe, no reescribir
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Reescribir todas las URLs al index.php
RewriteRule ^(.*)$ index.php [QSA,L]
