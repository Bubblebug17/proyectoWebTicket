{
    "name": "proyecto/ticket-system",
    "description": "Sistema de gestión de tickets con PHP 8.2",
    "type": "project",
    "require": {
        "php": ">=8.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php tools/phpunit.phar",
        "test:unit": "@php tools/phpunit.phar --testsuite Unit",
        "test:install": "@php tools/install-phpunit.php"
    }
}
